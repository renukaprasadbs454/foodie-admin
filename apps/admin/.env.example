# Server-only backend base URL for BFF route handlers (never NEXT_PUBLIC).
FOODIE_API_BASE_URL=https://api.foodie.example.com

# Optional client WS bootstrap (Phase 2 feature subscriptions).
NEXT_PUBLIC_WS_URL=https://api.foodie.example.com/ws

# Cookie Secure flag — false for local http only.
FOODIE_COOKIE_SECURE=true
