{
  "name": "foodie-shared-web",
  "version": "0.1.0",
  "description": "Shared Next.js/React foundation package for Foodie Admin Panel",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "@stomp/stompjs": "^7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-redux": "^9.0.0",
    "sockjs-client": "^1.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@stomp/stompjs": "^7.1.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "sockjs-client": "^1.6.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  }
}
